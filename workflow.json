        "jsCode": "const incoming=$input.first().json; const value=incoming.body && typeof incoming.body==='object'?incoming.body:incoming; for(const key of [\"source\"]) if(value[key]===undefined || value[key]===null || value[key]==='') throw new Error('Missing '+key); return [{json:value}];"
